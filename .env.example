# Copy this file to .env for local development. Keep real secrets only in .env.
PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
DATABASE_URL=
DATABASE_SSL=false
ALLOW_EPHEMERAL_SQLITE=false
PUBLIC_ORIGIN=http://localhost:3000
TRUST_PROXY=0

# Firebase web app settings from Firebase Console → Project settings → Your apps.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Firebase Admin service-account values. Generate a new JSON key in
# Google Cloud Console → IAM & Admin → Service Accounts → Keys, then copy
# client_email and private_key into .env. Keep literal \n characters in the key.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# SMTP password-reset delivery. Gmail requires a 2-Step Verification app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=your-email@gmail.com

# Optional AI recipe fallback from Google AI Studio's available tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
